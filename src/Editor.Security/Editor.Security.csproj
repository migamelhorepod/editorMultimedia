<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Required by generated Windows P/Invoke stubs; app code does not access raw memory. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Expose security-policy helpers only to the automated test assembly. -->
    <InternalsVisibleTo Include="Editor.Timeline.Tests" />
  </ItemGroup>
</Project>
